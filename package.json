{
  "name": "needit-deck-cue",
  "productName": "needit Deck Cue",
  "version": "0.7.4",
  "description": "Cue launcher for PowerPoint, WPS Office, Keynote and PDF presentations, with a Command Center app that runs many of them from one computer",
  "author": {
    "name": "needit Creative",
    "url": "https://needitcreative.com"
  },
  "homepage": "https://needitcreative.com",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unilordgr/needit-deck-cue.git"
  },
  "bugs": "https://github.com/unilordgr/needit-deck-cue/issues",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "start:center": "electron . --center",
    "dist:center:mac": "electron-builder --mac --config builder-center.json",
    "dist:center:win": "electron-builder --win --config builder-center.json"
  },
  "build": {
    "appId": "com.needitcreative.deckcue",
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "needit Deck Cue controls your presentation app to run your cues."
      },
      "icon": "build/icon.png"
    },
    "copyright": "Copyright © 2026 needit Creative · needitcreative.com",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders,wasm}/**",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox*}",
      "!node_modules/pdfjs-dist/**/*.map",
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "needit-Deck-Cue-Setup.${ext}",
      "shortcutName": "needit Deck Cue"
    },
    "portable": {
      "artifactName": "needit-Deck-Cue-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
